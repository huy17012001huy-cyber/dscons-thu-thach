APP_NAME="DSCons"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

# Local Docker login. Use AUTH_MODE=google on the VPS.
AUTH_MODE=password

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=website_thu_thach
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Staging must keep mail and external services disabled until its own credentials exist.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth — callback URL must exactly match Google Cloud configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
BRAND_DOMAIN=localhost
BRAND_PRIMARY=#1F77BE
BRAND_ACCENT=#E1F4F7
BRAND_BACKGROUND=#F7FAFC
