APP_NAME="DSCons"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

# Staging/VPS must use Google-only login.
AUTH_MODE=google

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=website_thu_thach_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@staging.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth — callback URL must exactly match Google Cloud configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

BRAND_DOMAIN=staging.example.com
BRAND_PRIMARY=#1F77BE
BRAND_ACCENT=#E1F4F7
BRAND_BACKGROUND=#F7FAFC
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Leave all external integrations empty until separately configured.
RESEND_API_KEY=
BREVO_API_KEY=
SEPAY_WEBHOOK_TOKEN=
SEPAY_BANK_ACCOUNT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
BOT_API_TOKEN=
REGISTER_WEBHOOK_SECRET=
